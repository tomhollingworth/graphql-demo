directive @goModel(model: String, models: [String!]) on OBJECT
  | INPUT_OBJECT
  | SCALAR
  | ENUM
  | INTERFACE
  | UNION

directive @goField(forceResolver: Boolean, name: String) on INPUT_FIELD_DEFINITION
  | FIELD_DEFINITION

scalar DateTime

scalar Any

input DateTimeRange {
  max: DateTime!
  min: DateTime!
}

enum OpcUaDataType {
  STRING
  INT
  FLOAT
  UNKNOWN
  BOOLEAN
  OTHER
}

type EquipmentProperty @key(fields: "iid") {
  iid:ID!
  address: String @external
  current: Tag @requires(fields: "address")
}

type Tag {
  address: ID!
  timestamp: DateTime!
  datatype: OpcUaDataType!
  value: Any!
}

type Query{
  readTag(address: ID!): Tag
  queryTag(addresses: [ID!]!): [Tag]
}