directive @goModel(model: String, models: [String!]) on OBJECT
  | INPUT_OBJECT
  | SCALAR
  | ENUM
  | INTERFACE
  | UNION

directive @goField(forceResolver: Boolean, name: String) on INPUT_FIELD_DEFINITION
  | FIELD_DEFINITION

scalar DateTime

input DateTimeRange {
  max: DateTime!
  min: DateTime!
}

extend type EquipmentProperty @key(fields: "id") {
  id:ID! @external
  address: String @external
  history(filter: DateTimeRange): [History] @requires(fields: "address")
}

type History {
  address: String!
  timestamp: DateTime!
  value: String!
  datatype: DataType!
}

enum DataType {
  STRING
  INT
  FLOAT
  UNKNOWN
  BOOLEAN
  OTHER
}

input FilterHistory {
  timestamp: DateTimeRange
  address: String
}

type Query {
  history(filter:FilterHistory!): [History!]!
}

input NewHistory {
  address: String!
  timestamp: DateTime!
  value: String!
  datatype: DataType!
}

type Mutation {
  createHistory(input: NewHistory!): History!
}
